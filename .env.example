# Community Skill Exchange — Public Runtime Environment
# Copy this file to `.env` when connecting to your Supabase development project.
#
# SECURITY WARNING:
# Only public client variables (`EXPO_PUBLIC_*`) belong here.
# NEVER put `SUPABASE_SERVICE_ROLE_KEY` or private backend secrets in this file.

# 'mock' (default for Stage 1-2 demo) | 'supabase' (Stage 3+)
EXPO_PUBLIC_DATA_MODE=mock

# Supabase project URL (e.g. https://xyzcompany.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=

# Supabase publishable / anon key
EXPO_PUBLIC_SUPABASE_ANON_KEY=
